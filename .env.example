# Local Resume Tailor - configuration
# Copy to .env and adjust. Nothing here ever points at a cloud service.

# Base URL for the local Ollama server.
# In WSL, Ollama running on Windows is usually reachable at the default
# gateway (see `ip route | grep default`). The app also auto-detects.
OLLAMA_BASE_URL=http://172.30.16.1:11434

# Model routing (per task family). The app detects installed models and will
# resolve a close tag if the exact one below is missing, and report the change.
#
# Only two local models are used:
#   Qwen 3.5   - extraction (resume / JD / answers), structured facts, and the
#                final claim validation pass.
#   Phi-4-mini - reasoning: requirement analysis, evidence matching, resume
#                tailoring, and cover-letter generation.
OLLAMA_EXTRACTION_MODEL=qwen3.5:4b
OLLAMA_REASONING_MODEL=phi4-mini:3.8b
OLLAMA_VALIDATION_MODEL=qwen3.5:4b

# Server port
PORT=5173

# Where local session JSON is persisted (never leaves the machine)
DATA_DIR=./data/sessions

# Max upload size in megabytes
MAX_UPLOAD_MB=15

# LLM request timeout (ms)
OLLAMA_TIMEOUT_MS=300000
